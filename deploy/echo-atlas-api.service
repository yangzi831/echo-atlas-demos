[Unit]
Description=Echo Atlas API and transcription relay
After=network.target

[Service]
Type=simple
User=echo-atlas-api
Group=echo-atlas-api
WorkingDirectory=/opt/echo-atlas-api/current
Environment=NODE_ENV=production
Environment=PORT=3198
ExecStart=/opt/node-v22.22.2-glibc-217/bin/node /opt/echo-atlas-api/current/server.cjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
MemoryLimit=256M
LimitNOFILE=2048
UMask=0077

[Install]
WantedBy=multi-user.target
